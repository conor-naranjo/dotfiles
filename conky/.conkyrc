conky.config = {
-- These configuration settings can be found at:
-- https://github.com/brndnmtthws/conky/wiki/Configuration-Settings

	out_to_x = false,
	own_window = false,
	out_to_console = true,
	background = false,
	max_text_width = 0,

-- Update interval in seconds
	update_interval = 2.0,

-- Number of times Conky will update before quitting
-- Set to zero to run forever.
	total_run_times = 0,

-- Shortens units to a single character (kiB->k, GiB->G, etc.). Default is off.
	short_units = true,

-- How strict should if_up be when testing an interface for being up?
-- The value is one of up, link or address, to check for the interface
-- being solely up, being up and having link or being up, having link
-- and an assigned IP address. 
	if_up_strictness = 'address',

-- Disable internal space padding so numbers don't have extra gaps
	use_spacer = 'none',

-- Force UTF8? note that UTF8 support required XFT
	override_utf8_locale = false,

-- number of cpu samples to average
-- set to 1 to disable averaging
	cpu_avg_samples = 2,

-- JSON for i3bar
-- Stuff after 'TEXT' will be formatted on screen
};

conky.text = [[
 [{ "full_text" : " ${time %a %b %d} <span foreground='\#383532'>│</span> ${time %H:%M} ", "markup" : "pango", "color" : "\#c8c4bc", "separator_block_width" : 10 },
  ${if_running spotify}{ "full_text" : " <span foreground='\#6e945c'>TRACK</span> ${exec $HOME/bin/spotify-now -i '%artist - %title' --escape} ", "markup" : "pango", "color" : "\#c8c4bc", "separator_block_width" : 10 },
  ${endif}{ "full_text" : " <span foreground='\#527294'>DISK</span> ${fs_free /home} Free ", "markup" : "pango", "color" : "\#c8c4bc", "separator_block_width" : 10 },
  { "full_text" : " <span foreground='\#527294'>RAM</span> ${memperc}% ", "markup" : "pango", "color" : ${if_match ${memperc}<90}"\#c8c4bc"${else}"\#cc3e3e"${endif}, "separator_block_width" : 10 },
  { "full_text" : " <span foreground='\#527294'>CPU</span> ${cpu cpu0}% (${hwmon k10temp temp 1}${hwmon coretemp temp 1}°C) ", "markup" : "pango", "color" : ${if_match ${cpu cpu0}<80}"\#c8c4bc"${else}"\#cc3e3e"${endif}, "separator_block_width" : 10 }${if_existing /sys/bus/pci/drivers/amdgpu},
  { "full_text" : " <span foreground='\#527294'>GPU</span> ${hwmon amdgpu temp 1}°C ", "markup" : "pango", "color" : ${if_match ${hwmon amdgpu temp 1}<85}"\#c8c4bc"${else}"\#cc3e3e"${endif}, "separator_block_width" : 10 }${endif}${if_existing /sys/class/power_supply/BAT0}${if_up wlan0},
  { "full_text" : " <span foreground='\#527294'>WIFI</span> ${wireless_essid wlan0} (${wireless_link_qual_perc wlan0}%) ", "markup" : "pango", "color" : "\#c8c4bc", "separator_block_width" : 10 }${endif},
  { "full_text" : " <span foreground='\#527294'>VPN</span> ${if_up wg0}<span foreground='\#6e945c'>UP</span>${else}${if_up tun0}<span foreground='\#6e945c'>UP</span>${else}${if_up tailscale0}<span foreground='\#6e945c'>UP</span>${else}<span foreground='\#78746e'>OFF</span>${endif}${endif}${endif} ", "markup" : "pango", "color" : "\#c8c4bc", "separator_block_width" : 10 },
  { "full_text" : " <span foreground='\#527294'>BAT</span> ${battery_short BAT0} (${battery_time BAT0}) ", "markup" : "pango", "color" : ${if_match ${battery_percent BAT0}<20}"\#cc3e3e"${else}"\#c8c4bc"${endif}, "separator_block_width" : 10 }${endif}],
]];
